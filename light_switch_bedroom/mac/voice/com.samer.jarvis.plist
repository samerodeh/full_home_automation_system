<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.samer.jarvis</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/samerodeh/projects/home_automation_system/light_switch_bedroom/mac/voice/start_jarvis.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/samerodeh/projects/home_automation_system/light_switch_bedroom/mac/voice</string>

    <!-- Start at login; restart if it crashes. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- Don't restart faster than every 10 s (prevents CPU spin on crash loop). -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>ProcessType</key>
    <string>Interactive</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/samerodeh</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/samerodeh/projects/home_automation_system/light_switch_bedroom/mac/voice/jarvis.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/samerodeh/projects/home_automation_system/light_switch_bedroom/mac/voice/jarvis.err.log</string>
</dict>
</plist>
