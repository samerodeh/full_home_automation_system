# Copy this file to ".env" and fill in your values. ".env" is gitignored,
# so any API keys stay off GitHub.

# --- Which brain answers questions? -----------------------------------------
# ollama = local, free, no account (default) | groq = fast cloud | gemini = cloud
LLM_PROVIDER=ollama

# --- Ollama (local, free, no account) ---------------------------------------
# Install from https://ollama.com, then:  ollama pull llama3.2:3b
# Bigger = better answers (but slower / larger): llama3.1:8b, qwen2.5:7b
OLLAMA_MODEL=llama3.2:3b
OLLAMA_HOST=http://localhost:11434

# --- Groq (optional cloud upgrade; free key, no credit card) ----------------
# Get a key at https://console.groq.com/keys, then set LLM_PROVIDER=groq above
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo

# --- Google Gemini (optional; free key) -------------------------------------
# Get a key at https://aistudio.google.com/apikey, then set LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Home automation (your ESP32 light switch over MQTT) --------------------
MQTT_BROKER=192.168.2.38
MQTT_PORT=1883
LIGHT_TOPIC=home/bedroom/light/set

# --- Remote phone app (JarvisRemote iOS app over MQTT) ----------------------
# A small mosquitto broker runs ON the Mac; the phone reaches it via Tailscale.
# This is SEPARATE from MQTT_BROKER above (that one drives the ESP32 lights).
# Setup: brew install mosquitto && mosquitto_passwd -c <pwfile> <user>
REMOTE_ENABLED=true
REMOTE_BROKER=127.0.0.1       # Jarvis connects to the Mac's local broker
REMOTE_PORT=1883
REMOTE_CMD_TOPIC=jarvis/command
REMOTE_REPLY_TOPIC=jarvis/reply
REMOTE_USERNAME=              # must match your mosquitto_passwd user
REMOTE_PASSWORD=
REMOTE_CLIENT_ID=jarvis-mac

# --- Live tools (weather) ---------------------------------------------------
DEFAULT_CITY=                 # blank = auto-detect your city by IP
WEATHER_UNITS=celsius         # celsius | fahrenheit

# --- Hands-free (wake word + voice-activity detection) ----------------------
WAKE_WORD=jarvis
END_SILENCE_SEC=0.8           # seconds of quiet before Jarvis treats you as done
FOLLOWUP_SEC=12               # stay awake this long after a reply (no wake word)
VAD_SENSITIVITY=3.0           # raise if it triggers on noise; lower if it misses you

# --- Speech -----------------------------------------------------------------
STT_PROVIDER=whisper          # whisper (local, free) | groq (cloud Whisper-large)
WHISPER_MODEL=base
RECORD_SECONDS=4
TTS_VOICE=Daniel
TTS_RATE=190
ASSISTANT_NAME=Jarvis
